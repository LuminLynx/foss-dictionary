{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/terms.schema.json",
  "title": "Glossary Term",
  "description": "Schema for validating glossary terms from terms.yaml",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Lowercase kebab-case identifier"
    },
    "term": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable term name"
    },
    "acronym": {
      "type": "string",
      "minLength": 1,
      "description": "Expanded acronym meaning",
      "nullable": true
    },
    "definition": {
      "type": "string",
      "minLength": 10,
      "description": "Concise explanation of the term"
    },
    "category": {
      "type": "string",
      "enum": ["licensing", "methodology", "infra", "backend"],
      "description": "Category of the term"
    },
    "why_it_matters": {
      "type": "string",
      "description": "Why this term is important",
      "nullable": true
    },
    "example": {
      "type": "string",
      "description": "Example usage or code snippet",
      "nullable": true
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "description": "List of related term IDs",
      "nullable": true
    },
    "note": {
      "type": "string",
      "description": "Additional commentary",
      "nullable": true
    },
    "emoji": {
      "type": "string",
      "description": "One or more emoji characters",
      "nullable": true
    },
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date in YYYY-MM-DD format",
      "nullable": true
    }
  },
  "required": ["id", "term", "definition", "category"],
  "additionalProperties": false
}
