{
  "name": "foss-dictionary",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:18",
  "postCreateCommand": "npm install",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "fix-related": "tsx scripts/validate/fixRelatedTerms.ts",
    "cleanup": "tsx scripts/validate/cleanupYaml.ts",
    "migrate": "tsx scripts/validate/migrateTerms.ts",
    "validate": "tsx scripts/validate/validateTerms.ts",
    "validate:terms:test": "node --loader ts-node/esm scripts/validate/ValidateTerms_Test.ts",
    "validate:all": "npm run validate:terms",
    "lint": "eslint . --ext .ts,.tsx",
    "dev": "npm-run-all --parallel dev:routes dev:next",
    "dev:routes": "node scripts/generateRoutes.js --watch",
    "dev:next": "next dev",
    "build": "next build",
    "build-index.js": "node scripts/build-index.js",
    "start": "next start",
    "format": "prettier . --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@hyperjump/browser": "^1.3.1",
    "@hyperjump/json-schema": "^1.16.2",
    "js-yaml": "^4.1.0",
    "leven": "^4.0.0",
    "next": "^14.2.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "chokidar": "^4.0.3",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^5.2.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "npm-run-all": "^4.1.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.14.0"
  }
}